# Required: replace this with a private random secret before starting the API.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# MySQL connection (defaults shown; adjust for your local MySQL account)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=santhi_cashew
DB_POOL_SIZE=5

# Optional: access-token lifetime in hours (default: 12)
JWT_ACCESS_TOKEN_HOURS=12

# Optional: enables the ADMIN_KEY header for administrator order status updates.
ADMIN_KEY=replace-with-a-private-admin-key
